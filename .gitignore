# Rehber videolari depoda TUTULMUYOR:
#  - GitHub'da dosya basi 100 MB, jsDelivr'de 20 MB sinir var
#  - Toplam ~107 MB; plan geregi YouTube'a tasinacaklar
#  - Tasinana kadar deploy bu makineden yapilmali (dosyalar yerel diskte)
*.mp4

# YouTube'a tasinan rehber videolarinin yerel arsivi
_media-archive/

# Astro uygulamasi
app/node_modules/
app/.astro/
app/dist/
app/.env
.verify-out.mjs
.prerender.mjs

