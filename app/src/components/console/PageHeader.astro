---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<header class="mb-7 flex flex-wrap items-end justify-between gap-4">
  <div class="min-w-0 max-w-2xl">
    {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
    <h1 class="text-2xl">{title}</h1>
    {lead && <p class="mt-2 text-sm text-[var(--color-muted)]">{lead}</p>}
  </div>
  <div class="flex shrink-0 items-center gap-2"><slot name="actions" /></div>
</header>
