---
import Base from '../../layouts/Base.astro';
import AuthPanel from '../../components/AuthPanel.tsx';
import CommandConsole from '../../components/console/CommandConsole.tsx';
import Diagnostics from '../../components/console/Diagnostics.tsx';
import PageHeader from '../../components/console/PageHeader.astro';
---

<Base title="EXC - Scan a repository" width="wide">
  <PageHeader
    eyebrow="Scan"
    title="Can you trust this repository?"
    lead="Every command from the CLI runs here too. Scans happen in your browser on your own GitHub account, so your code never reaches us and you spend your own API quota."
  />

  <div class="mb-10">
    <AuthPanel client:load />
  </div>

  <CommandConsole client:load />

  <div class="mt-14 max-w-2xl">
    <Diagnostics client:visible />
  </div>
</Base>
