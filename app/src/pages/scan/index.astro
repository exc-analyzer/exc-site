---
import Base from '../../layouts/Base.astro';
import AuthPanel from '../../components/AuthPanel.tsx';
import CommandConsole from '../../components/console/CommandConsole.tsx';
import Diagnostics from '../../components/console/Diagnostics.tsx';
---

<Base title="EXC Analyzer — Scan a repository">
  <div class="mb-8 max-w-2xl">
    <p class="eyebrow">Scan</p>
    <h1 class="mt-3 text-3xl">Can you trust this repository?</h1>
    <p class="mt-3 text-[var(--color-muted)]">
      Every command from the CLI runs here too. Scans happen in your browser on your own GitHub
      account, so your code never reaches us and you spend your own API quota.
    </p>
  </div>

  <div class="mb-10">
    <AuthPanel client:load />
  </div>

  <CommandConsole client:load />

  <div class="mt-14 max-w-2xl">
    <Diagnostics client:visible />
  </div>
</Base>
