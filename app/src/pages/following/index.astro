---
import Base from '../../layouts/Base.astro';
import FollowingList from '../../components/follow/FollowingList.tsx';
import Replies from '../../components/follow/Replies.tsx';
import PageHeader from '../../components/console/PageHeader.astro';
---

<Base title="EXC - Following">
  <div class="mx-auto max-w-[680px]">
    <PageHeader
      eyebrow="Following"
      title="What moved while you were away"
      lead="Replies addressed to you, and every repository you follow with whatever has happened to it since you last looked."
    />
    <div class="space-y-8">
      <Replies client:load />
      <FollowingList client:load />
    </div>
  </div>
</Base>
