---
import Base from '../layouts/Base.astro';
import Feed from '../components/feed/Feed.tsx';
import RecentReports from '../components/console/RecentReports.tsx';
---

<Base title="EXC Analyzer — What people are finding">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div class="max-w-2xl">
      <p class="eyebrow">Discover</p>
      <h1 class="mt-3 text-3xl">What people are finding</h1>
      <p class="mt-3 text-[var(--color-muted)]">
        Every scan anyone runs shows up here, alongside what people write about the repositories
        they depend on.
      </p>
    </div>
    <a href="/app/scan/" class="btn btn-primary shrink-0">Scan a repository</a>
  </div>

  <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_18rem]">
    <Feed client:load />
    <div class="hidden lg:block">
      <RecentReports client:visible />
    </div>
  </div>
</Base>
