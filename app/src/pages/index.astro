---
import Base from '../layouts/Base.astro';
import AuthPanel from '../components/AuthPanel.tsx';
import CommandConsole from '../components/console/CommandConsole.tsx';
import Diagnostics from '../components/console/Diagnostics.tsx';
import RecentReports from '../components/console/RecentReports.tsx';
---

<Base title="Uygulama — EXC Analyzer">
  <div class="mb-10 max-w-2xl">
    <p class="eyebrow">Uygulama</p>
    <h1 class="mt-2 text-3xl font-bold sm:text-4xl">
      Bir depo seç, ne durumda olduğunu gör
    </h1>
    <p class="mt-3 text-[var(--color-muted)]">
      CLI'deki bütün komutlar burada da çalışıyor. Analiz senin tarayıcında, senin GitHub
      hesabınla yapılır: kod bize gönderilmez, kendi API kotanı kullanırsın.
    </p>
  </div>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="min-w-0">
      <AuthPanel client:load />
    </div>
    <div class="min-w-0">
      <RecentReports client:load />
    </div>
  </div>

  <div class="mt-12">
    <CommandConsole client:load />
  </div>

  <div class="mt-12 max-w-2xl">
    <Diagnostics client:load />
  </div>
</Base>
