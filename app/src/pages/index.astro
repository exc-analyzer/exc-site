---
import Base from '../layouts/Base.astro';
import AuthPanel from '../components/AuthPanel.tsx';
import CommandConsole from '../components/console/CommandConsole.tsx';
import Diagnostics from '../components/console/Diagnostics.tsx';
import RecentReports from '../components/console/RecentReports.tsx';
---

<Base title="EXC Analyzer — Scan a repository">
  <div class="mb-10 max-w-2xl">
    <p class="eyebrow">Console</p>
    <h1 class="mt-2 text-3xl font-bold sm:text-4xl">
      Can you trust this repository?
    </h1>
    <p class="mt-3 text-[var(--color-muted)]">
      Every command from the CLI runs here too. Scans happen in your browser on your own
      GitHub account, so your code never reaches us and you spend your own API quota.
    </p>
  </div>

  <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="min-w-0">
      <AuthPanel client:load />
    </div>
    <div class="min-w-0">
      <RecentReports client:load />
    </div>
  </div>

  <div class="mt-12">
    <CommandConsole client:load />
  </div>

  <div class="mt-12 max-w-2xl">
    <Diagnostics client:load />
  </div>
</Base>
