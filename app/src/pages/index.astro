---
import Base from '../layouts/Base.astro';
import AuthPanel from '../components/AuthPanel.tsx';
import CommandConsole from '../components/console/CommandConsole.tsx';
import Diagnostics from '../components/console/Diagnostics.tsx';
---

<Base title="EXC Analyzer — Uygulama">
  <div class="max-w-2xl">
    <h1 class="text-2xl font-semibold tracking-tight">Uygulama</h1>
    <p class="mt-2 text-sm text-[var(--color-muted)]">
      CLI'deki bütün komutlar burada da çalışıyor. Analiz senin tarayıcında, senin GitHub
      hesabınla yapılır: kod bize gönderilmez, kendi API kotanı kullanırsın.
    </p>
  </div>

  <div class="mt-8 max-w-2xl">
    <AuthPanel client:load />
  </div>

  <div class="mt-6 max-w-2xl">
    <Diagnostics client:load />
  </div>

  <div class="mt-12">
    <CommandConsole client:load />
  </div>
</Base>
