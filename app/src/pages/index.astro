---
import Base from '../layouts/Base.astro';
import Feed from '../components/feed/Feed.tsx';
import PageHeader from '../components/console/PageHeader.astro';
---

<Base title="EXC - What people are finding">
  <div class="mx-auto max-w-[620px]">
    <PageHeader eyebrow="Home" title="What people are finding">
      <a slot="actions" href="/app/scan/" class="btn btn-primary">Scan a repository</a>
    </PageHeader>
    <Feed client:load />
  </div>
</Base>
