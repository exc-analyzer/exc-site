---
import '../styles/global.css';
import FollowingLink from '../components/follow/FollowingLink.tsx';
import HeaderAuth from '../components/HeaderAuth.tsx';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Analyse GitHub repositories, measure how well they are defended, and share what you find.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EXC Analyzer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://exc-analyzer.web.app/og/default.png?v=1" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen">
    <div class="relative z-10 flex min-h-screen flex-col">
      <header class="sticky top-0 z-30 border-b border-[var(--color-line)] bg-[rgba(10,9,18,0.72)] backdrop-blur-xl">
        <div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between px-6">
          <a href="/" class="flex items-center gap-2.5">
            <img
              src="/app/logo.png"
              alt=""
              width="28"
              height="28"
              class="size-7"
              aria-hidden="true"
            >
            <span class="text-sm font-semibold tracking-tight">EXC Analyzer</span>
          </a>

          <nav class="flex items-center gap-1 text-sm">
            <a href="/app/" class="btn btn-quiet">Discover</a>
            <a href="/app/scan/" class="btn btn-quiet">Scan</a>
            <FollowingLink client:idle />
            <HeaderAuth client:idle />
            <a
              href="https://github.com/exc-analyzer/exc"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-quiet">GitHub</a
            >
          </nav>
        </div>
      </header>

      <main class="mx-auto w-full max-w-[1200px] flex-1 px-6 py-10 sm:py-14">
        <slot />
      </main>

      <footer class="border-t border-[var(--color-line)]">
        <div
          class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-3 px-6 py-6 text-xs text-[var(--color-faint)]"
        >
          <p>Scans run in your browser, on your own GitHub account. Your code never reaches us.</p>
          <a href="https://github.com/exc-analyzer/exc" class="link">Source</a>
        </div>
      </footer>
    </div>
  </body>
</html>
