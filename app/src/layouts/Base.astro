---
import '../styles/global.css';
import FollowingLink from '../components/follow/FollowingLink.tsx';
import HeaderAuth from '../components/HeaderAuth.tsx';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Analyse GitHub repositories, measure how well they are defended, and share what you find.',
} = Astro.props;

const path = Astro.url.pathname;
const NAV = [
  { href: '/app/', label: 'Discover', active: path === '/app/' || path === '/app' },
  { href: '/app/scan/', label: 'Scan', active: path.startsWith('/app/scan') },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EXC Analyzer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://exc-analyzer.web.app/og/default.png?v=1" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen">
    <div class="relative z-10 mx-auto flex w-full max-w-[1180px]">
      <aside
        class="sticky top-0 hidden h-screen w-[232px] shrink-0 flex-col border-r border-[var(--color-line)] px-4 py-6 lg:flex"
      >
        <a href="/" class="mb-8 flex items-center gap-2.5 px-3">
          <img src="/app/logo.png" alt="" width="26" height="26" class="size-[26px]" />
          <span class="text-sm font-semibold tracking-tight">EXC Analyzer</span>
        </a>

        <nav class="flex flex-col gap-1">
          {
            NAV.map((item) => (
              <a href={item.href} class:list={['nav-item', item.active && 'nav-item-active']}>
                {item.label}
              </a>
            ))
          }
          <FollowingLink client:idle />
        </nav>

        <div class="mt-auto space-y-4 px-3">
          <HeaderAuth client:idle />
          <p class="text-2xs leading-relaxed text-[var(--color-faint)]">
            Scans run in your browser, on your own GitHub account. Your code never reaches us.
          </p>
          <a href="https://github.com/exc-analyzer/exc" class="text-2xs text-[var(--color-faint)] hover:text-[var(--color-muted)]">
            Source on GitHub
          </a>
        </div>
      </aside>

      <div class="min-w-0 flex-1">
        <header
          class="sticky top-0 z-30 border-b border-[var(--color-line)] bg-[rgba(10,9,18,0.82)] backdrop-blur-xl lg:hidden"
        >
          <div class="flex h-14 items-center justify-between gap-3 px-4">
            <a href="/" class="flex items-center gap-2">
              <img src="/app/logo.png" alt="" width="24" height="24" class="size-6" />
              <span class="text-sm font-semibold">EXC Analyzer</span>
            </a>
            <HeaderAuth client:idle />
          </div>
          <nav class="flex gap-1 overflow-x-auto px-3 pb-2">
            {
              NAV.map((item) => (
                <a href={item.href} class:list={['nav-pill', item.active && 'nav-pill-active']}>
                  {item.label}
                </a>
              ))
            }
            <FollowingLink client:idle />
          </nav>
        </header>

        <main class="px-4 py-8 sm:px-8 sm:py-10">
          <slot />
        </main>

        <footer class="border-t border-[var(--color-line)] px-4 py-6 sm:px-8 lg:hidden">
          <p class="text-2xs text-[var(--color-faint)]">
            Scans run in your browser, on your own GitHub account.
          </p>
        </footer>
      </div>
    </div>
  </body>
</html>
