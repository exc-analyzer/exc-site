---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'GitHub depolarını analiz et, güvenlik duruşunu ölç, bulgularını toplulukla paylaş.',
} = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" />

    <!-- Tanıtım sayfasıyla aynı yazı tipleri; iki taraf arasında kopma olmasın. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen">
    <div class="relative z-10 flex min-h-screen flex-col">
      <header class="sticky top-0 z-30 border-b border-[var(--color-line)] bg-[rgba(10,10,12,0.72)] backdrop-blur-xl">
        <div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between px-6">
          <a href="/" class="flex items-center gap-2.5">
            <span
              class="grid size-7 place-items-center rounded-lg bg-gradient-to-br from-[var(--color-primary)] to-[var(--color-primary-deep)] text-[13px] font-bold text-white"
              aria-hidden="true">E</span
            >
            <span class="text-sm font-semibold tracking-tight">EXC Analyzer</span>
          </a>

          <nav class="flex items-center gap-1 text-sm">
            <a href="/app/" class="btn btn-quiet">Uygulama</a>
            <a href="/app/profil/" class="btn btn-quiet">Profil</a>
            <a
              href="https://github.com/exc-analyzer/exc"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-quiet">GitHub</a
            >
          </nav>
        </div>
      </header>

      <main class="mx-auto w-full max-w-[1200px] flex-1 px-6 py-10 sm:py-14">
        <slot />
      </main>

      <footer class="border-t border-[var(--color-line)]">
        <div
          class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-3 px-6 py-6 text-xs text-[var(--color-faint)]"
        >
          <p>Analizler tarayıcında, kendi GitHub hesabınla çalışır. Kodun bize gönderilmez.</p>
          <a href="https://github.com/exc-analyzer/exc" class="link">Kaynak kod</a>
        </div>
      </footer>
    </div>
  </body>
</html>
