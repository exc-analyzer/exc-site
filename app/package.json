{
  "name": "app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run check && npm run test:rules && npm run test:richtext && npm run build",
    "test:rules": "node --run _rules:bundle && node .rules.mjs",
    "test:richtext": "node --run _richtext:bundle && node .richtext.mjs",
    "_richtext:bundle": "esbuild scripts/richtext.test.tsx --bundle --platform=node --format=esm --target=node22 --jsx=automatic --external:react --external:react-dom --outfile=.richtext.mjs --log-level=warning",
    "_rules:bundle": "esbuild scripts/rules.test.ts --bundle --platform=node --format=esm --target=node22 --outfile=.rules.mjs --log-level=warning",
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "verify": "node --run _verify:bundle && node .verify-out.mjs",
    "_verify:bundle": "esbuild scripts/verify-engine.ts --bundle --platform=node --format=esm --target=node22 --outfile=.verify-out.mjs --log-level=warning",
    "prerender": "node --run _prerender:bundle && node .prerender.mjs",
    "_prerender:bundle": "esbuild scripts/prerender.ts --bundle --platform=node --format=esm --target=node22 --external:puppeteer-core --outfile=.prerender.mjs --log-level=warning",
    "_rls:bundle": "esbuild scripts/check-rls.ts --bundle --platform=node --format=esm --target=node22 --outfile=.rls.mjs --log-level=warning",
    "check:rls": "node --run _rls:bundle && node .rls.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.9.0",
    "typescript": "^6.0.3"
  }
}
